# ============================================
# Akademitrading Production Environment
# ============================================

# --- Frontend (Netlify) ---
NEXT_PUBLIC_API_URL=https://api.akademitrading.com
NEXT_PUBLIC_BASE_URL=https://akademitrading.com
NEXT_PUBLIC_GOOGLE_ENABLED=true
NEXTAUTH_SECRET=REPLACE-with-long-random-string
NEXTAUTH_URL=https://akademitrading.com

# --- Google OAuth ---
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# --- Midtrans Payment ---
MIDTRANS_SERVER_KEY=your-server-key
MIDTRANS_BASE_URL=https://app.midtrans.com
MIDTRANS_CLIENT_KEY=your-client-key

# --- Telegram Bot ---
BOT_TOKEN=your-telegram-bot-token
CHANNEL_IDS=-100xxxxxxxxxx

# --- Database (Neon PostgreSQL) ---
DATABASE_URL=postgres://user:password@ep-xxx.ep.neon.tech/akademitrading?sslmode=require

# --- Redis (Upstash) ---
REDIS_URL=rediss://default:xxx@xxx.upstash.io:6379
